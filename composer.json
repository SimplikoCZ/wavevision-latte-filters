{
  "name": "simplikocz/latte-filters",
  "description": "Extra filters for Latte template engine.",
  "type": "library",
  "license": "MIT",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Wavevision\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wavevision\\": "tests"
    }
  },
  "authors": [
    {
      "name": "Wavevision s.r.o.",
      "email": "info@wavevision.com"
    },
    {
      "name": "Jakub Filla",
      "email": "jakub.filla@wavevision.com"
    },
    {
      "name": "Vít Rozsíval",
      "email": "vit@wavevision.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "latte/latte": "^3.0",
    "nette/http": "^3.0",
    "wavevision/utils": "^3.0"
  },
  "require-dev": {
    "php-coveralls/php-coveralls": "^2.5",
    "wavevision/coding-standard": "^7.0",
    "wavevision/di-service-annotation": "^5.0",
    "wavevision/nette-tests": "^4.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-di-service-annotation"
    },
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-utils"
    },
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-nette-tests"
    },
    {
      "type": "vcs",
      "url": "https://github.com/SimplikoCZ/wavevision-coding-standard"
    }
  ]
}
